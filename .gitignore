# Entornos virtuales
.env/
.venv/
venv/
env/

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Archivos de logs y errores
*.log
*.out
*.err

# Archivos de configuración del sistema
.DS_Store
Thumbs.db

# Archivos de Jupyter Notebook
*.ipynb_checkpoints
.ipynb_checkpoints/

# Metadata de pytest y coverage
.cache/
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Build, distribución y wheel
build/
dist/
*.egg-info/

# CuPy cache (kernels compilados)
~/.cupy_kernel_cache/
cupy_module_cache/

# Configuraciones de IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Cursor IDE
.cursor/

# Archivos ZIP o paquetes exportados
*.zip
*.tar.gz
*.whl

# Archivos temporales del sistema
*.tmp
*.temp
*~

# Archivos de backup
*.bak
*.backup

# Archivos de configuración local
.env.local
.env.development
.env.test
.env.production

# Archivos de datos temporales
*.dat
*.csv.tmp
*.json.tmp

# Archivos de profiling y debugging
*.prof
*.pstats
debug.log

# Archivos de configuración de mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Archivos de configuración de black
.black_cache/

# Archivos de configuración de flake8
.flake8_cache/

# Archivos de configuración de coverage
.coverage.*
